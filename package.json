{
    "name": "@popovnx/md-to-docx-dstu",
    "version": "0.1.2",
    "description": "Combine Markdown and DOCX fragments into a single DOCX",
    "license": "MIT",
    "author": "popovnx",
    "engines": {
        "node": ">=18.0.0"
    },
    "main": "dist/index.js",
    "bin": {
        "md-to-docx": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsx src/index.ts",
        "test": "tsx --test 'src/**/*.test.ts'",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "commander": "^14.0.3",
        "docx": "^9.6.1",
        "image-size": "^2.0.2",
        "jszip": "^3.10.1",
        "listr2": "^10.2.1",
        "markdown-it": "^14.1.1",
        "markdown-it-attrs": "^4.3.1",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "smol-toml": "^1.9.0"
    },
    "devDependencies": {
        "@types/markdown-it": "^14.1.2",
        "@types/markdown-it-attrs": "^4.1.3",
        "@types/node": "^25.5.0",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    }
}
